{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/integrations/google-calendar/dispatch",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/notifications/dispatch",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/reminders/dispatch",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/confirmations/dispatch",
      "schedule": "* * * * *"
    }
  ]
}
