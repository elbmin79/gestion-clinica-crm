# Copy to .env.local only after a clinic-owned Supabase project is configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never place a Supabase secret/service-role key in NEXT_PUBLIC_* or browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Appointment reminder delivery stays disabled until the clinic configures its
# approved Meta WhatsApp templates, credentials, and a trusted scheduler.
REMINDER_DISPATCH_SECRET=
WHATSAPP_CLOUD_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
WHATSAPP_TEMPLATE_CONFIRMATION_2D=
WHATSAPP_TEMPLATE_REMINDER_1D=
WHATSAPP_TEMPLATE_REMINDER_5H=
CLINIC_TIME_ZONE=America/Tijuana
