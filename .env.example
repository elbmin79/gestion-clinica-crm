# Copy to .env.local only after a clinic-owned Supabase project is configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never place a Supabase secret/service-role key in NEXT_PUBLIC_* or browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar OAuth (server-only). The callback URI must exactly match
# the web OAuth client configured in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gestion-clinica-crm.vercel.app/api/integrations/google-calendar/callback
# Base64-encoded 32-byte key used to encrypt Google refresh tokens at rest.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Random bearer secret used to authenticate the scheduled sync route.
CRON_SECRET=

# WhatsApp dispatch is simulated in development. Production stays disabled.
WHATSAPP_PROVIDER_MODE=mock
# Optional bearer secret for the local/test scheduler route.
REMINDER_DISPATCH_SECRET=

# The signed webhook remains available for future provider setup; do not
# register it with Meta in this mock-only phase.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Web Push: generate a matched pair once with `npx web-push generate-vapid-keys`.
# Public key is returned by the authenticated status endpoint; private key stays server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-clinic.example
# CRON_SECRET above authenticates /api/notifications/dispatch as well.

# Optional exact additional push-service hostnames for managed browser environments.
# Leave empty for standard Chrome, Firefox, Safari and Edge. Never use user-supplied hosts.
PUSH_EXTRA_SERVICE_HOSTS=

# Public appointment requests. Use a stable random signing secret, at least 32 characters.
PUBLIC_BOOKING_SECRET=
# Production requires a real Cloudflare Turnstile widget for this hostname.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Vercel uses x-vercel-forwarded-for automatically. On other hosts, set only
# a header that your trusted reverse proxy overwrites (never trust arbitrary client headers).
PUBLIC_BOOKING_IP_HEADER=
