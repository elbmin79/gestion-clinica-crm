{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "CRM_NATIVE_BUILD": "1",
        "EXPO_PUBLIC_CRM_API_URL": "https://gestion-clinica-crm.vercel.app"
      }
    },
    "development-emulator": {
      "extends": "development",
      "android": {
        "gradleCommand": ":app:assembleDebug -PreactNativeArchitectures=x86_64"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "CRM_NATIVE_BUILD": "1",
        "EXPO_PUBLIC_CRM_API_URL": "https://gestion-clinica-crm.vercel.app"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "testflight": {
      "extends": "production",
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "env": {
        "CRM_NATIVE_BUILD": "1",
        "EXPO_PUBLIC_CRM_API_URL": "https://gestion-clinica-crm.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
