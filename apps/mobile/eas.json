{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "CRM_NATIVE_BUILD": "1",
        "EXPO_PUBLIC_CRM_API_URL": "https://gestion-clinica-crm.vercel.app"
      }
    },
    "development-emulator": {
      "extends": "development",
      "android": {
        "gradleCommand": ":app:assembleDebug -PreactNativeArchitectures=x86_64"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "CRM_NATIVE_BUILD": "1",
        "EXPO_PUBLIC_CRM_API_URL": "https://gestion-clinica-crm.vercel.app"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "env": {
        "CRM_NATIVE_BUILD": "1",
        "EXPO_PUBLIC_CRM_API_URL": "https://gestion-clinica-crm.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
