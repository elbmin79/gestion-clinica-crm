{
  "expo": {
    "name": "Elixir Clinic",
    "slug": "elixir-clinic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "elixirclinic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.elixirclinic.crm",
      "supportsTablet": true,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.elixirclinic.crm",
      "adaptiveIcon": {
        "backgroundColor": "#F9F0F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EFE4EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://smxzwnmgwbqxhglgqjff.supabase.co",
      "supabasePublishableKey": "sb_publishable_6VeJIFfyB-ba2AJ9OA2WsA_eY6oOFp6",
      "crmApiUrl": "https://gestion-clinica-crm.vercel.app",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "66120581-b4c4-4a20-82d1-df1ed7a6cc17"
      }
    },
    "owner": "mkz-solutions"
  }
}
